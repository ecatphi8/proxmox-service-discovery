[Unit]
Description=Proxmox Service Discovery
After=network.target

[Service]
EnvironmentFile=/usr/local/etc/proxmox-service-discover.env
ExecStart=/usr/local/bin/proxmox-service-discovery \
  --proxmox-host=${PROXMOX_NODE} \
  --proxmox-user=${PROXMOX_USER} \
  --proxmox-token-id=${PROXMOX_TOKEN_ID} \
  --proxmox-token-secret=${PROXMOX_TOKEN_SECRET} \
  --addr=*:53 \
  --debug-addr=*:8080 \
  --dns-zone=${DOMAIN}
Restart=on-failure
User=nobody
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target


