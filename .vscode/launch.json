    "version": "0.2.0",
    "configurations": [ 
        {
            "name": "Launch file",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": ["--proxmox-host=${env:PROXMOX_NODE}",
            "--proxmox-user=${env:PROXMOX_USER}",
            "--proxmox-token-id=${env:PROXMOX_TOKEN_ID}",
            "--proxmox-token-secret=${env:PROXMOX_TOKEN_SECRET}",
            "--addr=:53",
            "--debug-addr=:8080",
            "--dns-zone=${env:DOMAIN}" ]
        }

    ]
}
